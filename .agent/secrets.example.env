# Variable names only. Never put real values in this file.
# Production: /etc/secretary/secret.env or Compose secrets, outside the vault.
# Paths are deployment values; the Core container mounts only its vault.
SECRETARY_VAULT_ROOT=/vault
SECRETARY_PUBLIC_ORIGIN=
SECRETARY_WEB_PASSWORD_HASH=
SECRETARY_SESSION_SIGNING_KEY=
SECRETARY_PI_INTERNAL_TOKEN=
SECRETARY_SECRETS_FILE=/run/secrets/secretary.env

# Pi uses the restricted internal proxy; only Core sees the provider key.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# OneBot v11 forward WebSocket, configured bot and private recipient.
QQ_WS_URL=
QQ_ACCESS_TOKEN=
QQ_BOT_ID=
SECRETARY_RECIPIENT=

# Private data repository only; SSH deploy key is outside the vault.
SECRETARY_GIT_REMOTE=
SECRETARY_GIT_SSH_KEY_FILE=
SECRETARY_GIT_KNOWN_HOSTS_FILE=
