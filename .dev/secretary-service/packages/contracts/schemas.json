                        "required": [
                          "business_date",
                          "status"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "report_event"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "event_key"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "link_diary"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "path",
                          "label"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "remember_fact"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "fact"
                        ]
                      }
                    }
                  ]
                }
              }
            },
            "required": [
              "action_identity",
              "actions"
            ],
            "additionalProperties": false
          }
        },
        "clarification": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "reply_intent": {
          "enum": [
            "receipt",
            "proposal",
            "discussion",
            "clarification"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "discussion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      "required": [
        "action_groups",
        "clarification",
        "reply_intent"
      ],
      "additionalProperties": false
    },
    "Criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "check",
            "count",
            "artifact"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "target": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "enum": [
            "self_report",
            "tool"
          ]
        },
        "artifact_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "additionalProperties": false
    },
    "NoteRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "heading": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "enum": [
            "motivation",
            "plan",
            "method",
            "evidence"
          ]
        }
      },
      "required": [
        "path",
        "relation"
      ],
      "additionalProperties": false
    }
  }
}
