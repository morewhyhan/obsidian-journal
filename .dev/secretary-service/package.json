{
  "name": "personal-secretary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx apps/core/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsx scripts/release.ts && tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start:production": "node dist/server/apps/core/main.js",
    "start": "tsx apps/core/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "fixture": "tsx scripts/fixture.ts",
    "password": "tsx scripts/password.ts",
    "init:backup": "tsx apps/core/cli.ts init-backup",
    "preflight": "tsx apps/core/cli.ts preflight",
    "contracts": "tsx scripts/contracts.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@huggingface/tokenizers": "0.2.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "lucide-react": "1.61.0",
    "luxon": "3.7.2",
    "markdown-it": "15.0.3",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "1.3.27",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/luxon": "3.7.6",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
