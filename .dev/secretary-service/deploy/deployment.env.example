# Deployment coordinates only; create a private copy outside the vault.
SECRETARY_DOMAIN=journal.example.com
SECRETARY_VAULT_HOST=/srv/secretary/vault
SECRETARY_SECRETS_FILE=/etc/secretary/secret.env
# Must match the corresponding entry in secret.env. No provider API key here.
SECRETARY_PI_INTERNAL_TOKEN=
LLM_MODEL=
# Pin resolved image digests before production deployment.
NODE_IMAGE=node:24-bookworm-slim
CADDY_IMAGE=caddy:2-alpine
