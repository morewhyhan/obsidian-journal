# Deployment coordinates only; create a private copy outside the vault.
SECRETARY_DOMAIN=journal.example.com
SECRETARY_VAULT_HOST=/srv/secretary/vault
SECRETARY_SECRETS_FILE=/etc/secretary/secret.env
# Set to 1 only after the host preflight confirms NTP synchronization.
SECRETARY_TIME_SYNCHRONIZED=0
# Must match corresponding entries in secret.env. The model key stays only in Core.
SECRETARY_BRIDGE_TOKEN=
SECRETARY_QQ_BOT_ID=
SECRETARY_RECIPIENT=
NAPCAT_WS_TOKEN=
NAPCAT_WEBUI_TOKEN=
LLM_MODEL=deepseek-flash
# Pin resolved image digests before production deployment.
NODE_IMAGE=node:24-bookworm-slim
CADDY_IMAGE=caddy:2-alpine
ASTRBOT_IMAGE=soulter/astrbot:v4.29.1
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
